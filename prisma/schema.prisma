// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  elo       Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdQuestions Question[]
  gameParticipants GameParticipant[]
  createdGames     Game[]            @relation("GameCreator")
  competitions     Competition[]

  @@map("users")
}

model Question {
  id          String      @id @default(cuid())
  text        String
  answer      String
  category    String
  imageUrl    String?
  videoUrl    String?
  createdBy   String
  approved    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  creator     User        @relation(fields: [createdBy], references: [id])
  gameQuestions GameQuestion[]

  @@map("questions")
}

model Game {
  id          String   @id @default(cuid())
  type        GameType
  status      GameStatus @default(WAITING)
  maxPlayers  Int      @default(10)
  createdBy   String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  endedAt     DateTime?

  creator      User?             @relation("GameCreator", fields: [createdBy], references: [id])
  participants GameParticipant[]
  questions    GameQuestion[]

  @@map("games")
}

model GameParticipant {
  id       String @id @default(cuid())
  gameId   String
  userId   String?
  username String?
  score    Int    @default(0)
  joinedAt DateTime @default(now())

  game   Game  @relation(fields: [gameId], references: [id])
  user   User? @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@unique([gameId, username])
  @@map("game_participants")
}

model GameQuestion {
  id         String @id @default(cuid())
  gameId     String
  questionId String
  order      Int

  game     Game     @relation(fields: [gameId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([gameId, questionId])
  @@unique([gameId, order])
  @@map("game_questions")
}

model Competition {
  id          String           @id @default(cuid())
  title       String
  description String?
  maxPlayers  Int              @default(50)
  status      CompetitionStatus @default(OPEN)
  startDate   DateTime
  endDate     DateTime
  createdBy   String
  createdAt   DateTime         @default(now())

  creator User @relation(fields: [createdBy], references: [id])

  @@map("competitions")
}

enum GameType {
  QUICKPLAY_FUN
  QUICKPLAY_COMPETITIVE
  COMPETITION
}

enum GameStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum CompetitionStatus {
  OPEN
  IN_PROGRESS
  FINISHED
}
